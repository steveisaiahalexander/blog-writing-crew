{
  // Display name for this crew
  "name": "blog-writing-crew",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["senior_research_analyst", "blog_content_writer", "blog_editor", "social_media_manager"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "research_the_topic_topic_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Research the topic \"{topic}\" thoroughly. Find key facts, recent trends, relevant statistics, and credible sources. Organize your findings into a structured research brief with clear sections, and flag any claim you could not verify.",

      // Clear definition of what the output should look like
      "expected_output": "A structured research brief in bullet points covering key facts, trends, statistics, and a list of source URLs.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "artifact": {"identifier": "report", "title": "Report", "kind": "markdown"},
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "senior_research_analyst"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
  
,
    {
      // Task identifier
      "name": "using_the_research_brief_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Using the research brief, write an engaging blog post about \"{topic}\". Include a strong hook, clear headings, short paragraphs, and a conclusion. Use only information supported by the research brief.",

      // Clear definition of what the output should look like
      "expected_output": "A complete blog post of about 800-1000 words in markdown format, with a title, introduction, body sections, and conclusion.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "artifact": {"identifier": "report", "title": "Report", "kind": "markdown"},
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "blog_content_writer",

      // Task outputs used as context
      "context": ["research_the_topic_topic_task"]

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      // Task identifier
      "name": "review_and_polish_the_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "Review and polish the blog post on \"{topic}\". Fix grammar and style issues, improve flow and clarity, remove repetition, and check that the post is consistent with the research brief. Make it ready to publish.",

      // Clear definition of what the output should look like
      "expected_output": "The final, publish-ready blog post in markdown format, with a consistent tone and no grammar or factual-consistency issues.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "artifact": {"identifier": "report", "title": "Report", "kind": "markdown"},
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "blog_editor",

      // Task outputs used as context
      "context": ["research_the_topic_topic_task", "using_the_research_brief_task"],

      "output_file": "output/blog_post.md"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    }
,
    {
      "name": "social_media_task",

      "description": "Using the polished blog post from the previous task, create social media content for two platforms: 1. A Twitter/X thread of 5-7 tweets that captures the key points of the blog post. The first tweet should hook the reader, and the thread should flow naturally from one tweet to the next. 2. A LinkedIn post summary (2-3 paragraphs) that highlights the main takeaways in a professional tone.",

      "expected_output": "A markdown file with two sections: a Twitter/X thread (5-7 numbered tweets, each under 280 characters) and a LinkedIn post summary (2-3 paragraphs).",

      "agent": "social_media_manager",

      "context": ["review_and_polish_the_task"],

      "output_file": "output/social_posts.md"
    }

  ],

  

  

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
  // "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "senior_research_analyst",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
